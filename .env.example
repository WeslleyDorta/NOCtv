# Copy to .env for Docker Compose. Keep real credentials out of Git.
NOCTV_CONFIG_FILE=./config/demo.json
NOCTV_BIND=127.0.0.1
NOCTV_PORT=8080
# Required in live mode: a user and a unique password of at least 16 characters.
NOCTV_USER=
NOCTV_PASSWORD=
# LibreNMS base URL includes /api/v0/; a read-only account is recommended.
LIBRENMS_URL=
LIBRENMS_TOKEN=
# Forcepoint base URL is the SMC origin (https://smc.example.com:8082).
FORCEPOINT_URL=
FORCEPOINT_KEY=
FORCEPOINT_DOMAIN=

# Optional integrations. Copy the matching configuration example.
ZABBIX_URL=
ZABBIX_TOKEN=
FORTIGATE_URL=
FORTIGATE_TOKEN=
PANOS_URL=
PANOS_API_KEY=
CHECKPOINT_URL=
CHECKPOINT_USERNAME=
CHECKPOINT_PASSWORD=
SOPHOS_URL=
SOPHOS_CLIENT_ID=
SOPHOS_CLIENT_SECRET=
SOPHOS_TENANT_ID=

# Optional metrics and inventory sources.
PROMETHEUS_URL=
PROMETHEUS_TOKEN=
NETBOX_URL=
NETBOX_TOKEN=

# Native checks and read-only Docker HTTPS endpoint (optional).
WEBSITE_CHECK_URL=
DOCKER_API_URL=
# Reference a proxy token via token_env in your local Docker connector if needed.
DOCKER_API_TOKEN=
